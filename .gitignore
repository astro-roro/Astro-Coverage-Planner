__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# User's private archive data — never commit
data/manifest.json
data/catalogs.json
data/gear.json
data/plans.json
data/target_overrides.json
data/sites.json
# Gear fingerprints reported by NINA — carry the site's lat/lon.
data/fingerprints.json
data/exports/
data/moc_cache/
data/*.local.json
# Backup snapshots written by the nina_ts_sync extension before any write.
# Useful locally for rollback, but never belong in version control.
data/plans-acpsync-*-backup.json
# Ad-hoc backups written by tooling / interactive sessions.
data/plans-backup-*.json
# Demo / recording plan files (used for screencasts, video walkthroughs).
data/plans-demo*.json
.cache/
.coverage
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Claude Code settings — keep local, never push
.claude/

# Private extensions (loaded at runtime from outside the repo)
blueprints/

# JS tooling (frontend test harness only — see tests/frontend/)
node_modules/

data/archive_manifest_summary.md

# Obsidian-vault-backed notes (see note-link)
/notes
