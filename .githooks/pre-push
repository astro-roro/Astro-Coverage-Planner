#!/bin/sh
# Refuse a push whose new commits add a private term, in their added lines,
# their messages, or their author and committer identities.
# Enable with: git config core.hooksPath .githooks
# The term list is read from ~/.config/acp-private-terms.txt when it exists.
# A branch the remote does not have yet is checked against <remote>/main
# (origin/main if the remote has no main).
terms="$HOME/.config/acp-private-terms.txt"
[ -f "$terms" ] || exit 0
remote="${1:-origin}"
root=$(git rev-parse --show-toplevel) || exit 1
py=$(command -v python3 || command -v python) || { echo "pre-push: python not found, private term check skipped" >&2; exit 0; }
check="$root/scripts/check_private_terms.py"
zero=0000000000000000000000000000000000000000

base_ref="refs/remotes/$remote/main"
git rev-parse -q --verify "$base_ref" >/dev/null || base_ref="refs/remotes/origin/main"

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac  # branch deletion
    case "$remote_sha" in
        *[!0]*)
            diff_range="$remote_sha..$local_sha"
            log_range="$remote_sha..$local_sha"
            ;;
        *)
            diff_range="$base_ref...$local_sha"
            log_range="$base_ref..$local_sha"
            ;;
    esac
    "$py" "$check" --terms "$terms" --diff "$diff_range" || status=1
    "$py" "$check" --terms "$terms" --messages "$log_range" || status=1
done

if [ "$status" -ne 0 ]; then
    echo "pre-push: push blocked by the private term check" >&2
fi
exit "$status"
